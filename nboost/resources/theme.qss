/* Nboost - dark cyber-neon glassmorphism theme */

* {
    font-family: "Segoe UI", "Cascadia Mono", sans-serif;
    outline: none;
}

QMainWindow, #centralRoot {
    background-color: #0b0e17;
}

/* ---------------- Sidebar ---------------- */
#sidebar {
    background-color: rgba(18, 22, 36, 0.92);
    border-right: 1px solid rgba(0, 245, 212, 0.12);
}

#brandLabel {
    color: #f4f6fb;
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 18px 20px 4px 20px;
}

#brandSubLabel {
    color: #6c7693;
    font-size: 11px;
    padding: 0px 20px 18px 20px;
}

QPushButton#navButton {
    background: transparent;
    color: #aab2c8;
    text-align: left;
    padding: 12px 20px;
    border: none;
    border-left: 3px solid transparent;
    font-size: 13px;
    font-weight: 500;
}
QPushButton#navButton:hover {
    background-color: rgba(0, 245, 212, 0.08);
    color: #f4f6fb;
}
QPushButton#navButton:checked {
    background-color: rgba(0, 245, 212, 0.14);
    color: #00f5d4;
    border-left: 3px solid #00f5d4;
}

/* ---------------- Glass cards ---------------- */
.GlassCard, QFrame#glassCard {
    background-color: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
}

QLabel#sectionTitle {
    color: #f4f6fb;
    font-size: 15px;
    font-weight: 700;
    padding-bottom: 2px;
}

QLabel#pageTitle {
    color: #f4f6fb;
    font-size: 22px;
    font-weight: 700;
}

QLabel#pageSubtitle {
    color: #7b84a0;
    font-size: 12px;
}

QLabel#statLabel { color: #aab2c8; font-size: 12px; }
QLabel#statValue { color: #f4f6fb; font-size: 13px; font-weight: 600; }

/* ---------------- Checkboxes ---------------- */
QCheckBox {
    color: #c9d1e3;
    font-size: 12.5px;
    padding: 6px 2px;
    spacing: 10px;
}
QCheckBox::indicator {
    width: 17px;
    height: 17px;
    border-radius: 5px;
    border: 1.5px solid rgba(0, 245, 212, 0.35);
    background: rgba(255, 255, 255, 0.03);
}
QCheckBox::indicator:hover { border-color: #00f5d4; }
QCheckBox::indicator:checked {
    background-color: #00f5d4;
    border-color: #00f5d4;
    image: none;
}

/* ---------------- Buttons ---------------- */
QPushButton#primaryBtn {
    background-color: #00f5d4;
    color: #04141b;
    font-weight: 700;
    font-size: 13px;
    border: none;
    border-radius: 10px;
    padding: 12px 22px;
}
QPushButton#primaryBtn:hover { background-color: #37ffe1; }
QPushButton#primaryBtn:pressed { background-color: #00c7ad; }
QPushButton#primaryBtn:disabled { background-color: #1f2a30; color: #5b6478; }

QPushButton#boostBtn {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #ff2fb0, stop:1 #7a3bff);
    color: #f4f6fb;
    font-weight: 800;
    font-size: 14px;
    border: none;
    border-radius: 12px;
    padding: 14px 24px;
}
QPushButton#boostBtn:hover { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #ff5fc6, stop:1 #9a63ff); }
QPushButton#boostBtn:disabled { background: #1f2430; color: #5b6478; }

QPushButton#secondaryBtn {
    background-color: rgba(255, 255, 255, 0.06);
    color: #c9d1e3;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 10px 18px;
    font-size: 12.5px;
}
QPushButton#secondaryBtn:hover { border-color: #00f5d4; color: #00f5d4; }

QPushButton#dangerBtn {
    background-color: rgba(255, 93, 115, 0.12);
    color: #ff5d73;
    border: 1px solid rgba(255, 93, 115, 0.35);
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 11.5px;
}
QPushButton#dangerBtn:hover { background-color: rgba(255, 93, 115, 0.22); }

/* ---------------- Console ---------------- */
#consoleWidget {
    background-color: rgba(6, 8, 14, 0.85);
    border: 1px solid rgba(0, 245, 212, 0.12);
    border-radius: 12px;
    color: #c9d1e3;
    padding: 10px;
    selection-background-color: rgba(0, 245, 212, 0.3);
}

/* ---------------- Progress / Scrollbars ---------------- */
QProgressBar {
    background-color: rgba(255, 255, 255, 0.06);
    border: none;
    border-radius: 6px;
    height: 10px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    border-radius: 6px;
    background-color: #00f5d4;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: rgba(0, 245, 212, 0.25);
    border-radius: 5px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover { background: rgba(0, 245, 212, 0.45); }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

QTableWidget {
    background-color: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 10px;
    color: #c9d1e3;
    gridline-color: rgba(255,255,255,0.06);
}
QHeaderView::section {
    background-color: rgba(255,255,255,0.05);
    color: #aab2c8;
    border: none;
    padding: 6px;
    font-weight: 600;
}
QTableWidget::item:selected { background-color: rgba(0,245,212,0.15); color: #f4f6fb; }

QToolTip {
    background-color: #161b28;
    color: #f4f6fb;
    border: 1px solid rgba(0,245,212,0.3);
    padding: 4px 8px;
    border-radius: 6px;
}
